<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Orange HRM Demo">

    <listeners>
        <listener class-name="reportConfigs.ExtentListener"/>
    </listeners>

    <parameter name="userURL" value="http://localhost:90/orangehrm5"/>

    <test name="Orange HRM - Login and Employee Management">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.OrangeHRM.login.LoginTests"/>
            <class name="com.OrangeHRM.pim.PIM_01_AddEmployeeTests"/>
            <class name="com.OrangeHRM.pim.PIM_02_EmployeeProfileTests"/>
            <class name="com.OrangeHRM.pim.PIM_03_EmployeeEmploymentTests"/>
        </classes>
    </test>

</suite>